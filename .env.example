# ============================================================
# 선물지니 환경변수 예시 — 복사해서 .env.local 로 저장하세요
# Netlify 배포 시에는 Site configuration → Environment variables 에 동일하게 등록
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저에 노출되므로 비밀 키를 넣지 마세요
# ============================================================

# --- AI 추천 (서버 전용) ---
OPENAI_API_KEY=sk-...

# --- Google AdSense ---
# 게시자 ID (기본값이 코드에 있으므로 보통 생략 가능)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-5907754718994620
# 광고 단위 슬롯 ID (AdSense → 광고 → 광고 단위 기준에서 발급, 숫자 10자리)
NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_IN_FEED=

# --- 쿠팡 파트너스 Open API (서버 전용, 절대 NEXT_PUBLIC_ 붙이지 말 것) ---
# partners.coupang.com → 링크 생성 → API 에서 발급
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 채널 구분용 (선택, 영문/숫자)
COUPANG_SUB_ID=couplegift

# --- 검색엔진 / 분석 ---
# 네이버 서치어드바이저 HTML 태그 인증값
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
# Google Analytics 4 측정 ID
NEXT_PUBLIC_GA_ID=

# --- 자동 블로그 발행 (GitHub Actions secrets 로 등록) ---
GEMINI_API_KEY=
PEXELS_API_KEY=
